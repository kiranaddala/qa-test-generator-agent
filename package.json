{
  "name": "qa-test-generator-agent",
  "version": "1.0.0",
  "description": "AI-powered QA Test Case Generator Agent using Playwright and Claude AI",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "ts-node src/index.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "generate-tests": "ts-node src/index.ts",
    "lint": "eslint src/**/*.ts",
    "build": "tsc",
    "clean": "rm -rf dist output/**/*.json"
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "ai",
    "automation"
  ],
  "author": "QA Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "openai": "^7.28.0",
    "playwright": "^1.40.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
